<?xml version="1.0" encoding="UTF-8"?>
<!--
  Default logging for the daemon. Without a configuration on the classpath, Logback falls back to
  its own default of DEBUG to the console, which in a container means every ScalarDB, Jetty, and
  Netty debug line ends up in the operator's log pipeline.

  Timestamps are UTC and ISO-8601 so lines from daemons in different time zones collate.

  Two override paths, neither of which needs a rebuild:
    - SCALAR_DB_SAGA_LOG_LEVEL=DEBUG changes the root level (Logback falls back to the OS
      environment when a variable is in no other scope).
    - JAVA_OPTS=-Dlogback.configurationFile=/path/to/logback.xml replaces this file wholesale, e.g.
      from a mounted ConfigMap, for anything more involved (per-logger levels, JSON encoding, a
      second appender).
-->
<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z', UTC} %-5level [%thread] %logger{40} - %msg%n</pattern>
    </encoder>
  </appender>

  <root level="${SCALAR_DB_SAGA_LOG_LEVEL:-INFO}">
    <appender-ref ref="STDOUT" />
  </root>
</configuration>
