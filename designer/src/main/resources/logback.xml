<?xml version="1.0" encoding="UTF-8"?>
<!--
  Default logging for the designer. Without a configuration on the classpath, Logback logs at DEBUG,
  which buries the one line a user needs (the URL to open) under Jetty's startup detail.
-->
<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{30} - %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="org.eclipse.jetty" level="WARN" />
  <logger name="io.javalin" level="WARN" />

  <root level="${SCALAR_DB_SAGA_DESIGNER_LOG_LEVEL:-INFO}">
    <appender-ref ref="STDOUT" />
  </root>
</configuration>
