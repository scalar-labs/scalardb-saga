<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- Suppress in test classes -->
  <Match>
    <Class name="~.*Test$"/>
    <Bug pattern="SE_BAD_FIELD"/>
  </Match>
  <Match>
    <Class name="~.*Test$"/>
    <Bug pattern="RV_RETURN_VALUE_IGNORED_NO_SIDE_EFFECT"/>
  </Match>
  <!-- Constructors called inside assertThatThrownBy lambdas are not meant to be thrown -->
  <Match>
    <Class name="~.*Test(\$.*)?"/>
    <Bug pattern="RV_EXCEPTION_NOT_THROWN"/>
  </Match>
  <!-- Test fixture classes that intentionally throw in constructors -->
  <Match>
    <Class name="~.*Test\$.*"/>
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
  </Match>
  <!-- Test fixture step/DI classes hold injected objects (e.g. SagaHttpClient) in fields by design -->
  <Match>
    <Class name="~.*Test(\$.*)?"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!-- Raw localhost ServerSocket in a test fixture injects a malformed Content-Length on the wire
       (the high-level HttpServer computes Content-Length itself); plaintext is fine for a test. -->
  <Match>
    <Class name="~.*Test(\$.*)?"/>
    <Bug pattern="UNENCRYPTED_SERVER_SOCKET"/>
  </Match>
  <!-- ThreadLocalRandom in RetryPolicy.sleepWithBackoff is for retry jitter, not security -->
  <Match>
    <Class name="com.scalar.db.saga.definition.RetryPolicy"/>
    <Method name="sleepWithBackoff"/>
    <Bug pattern="PREDICTABLE_RANDOM"/>
  </Match>
  <!-- CT_CONSTRUCTOR_THROW surfaces only when compiling to Java 8 bytecode (the api module's
       release-8 target). SpotBugs auto-suppresses this finalizer-attack finding for Java 15+
       bytecode (class version 59+) but reports it for Java 8 bytecode. The api value types and
       exceptions validate their constructor arguments by design; they are not finalizer-attack
       vectors in practice. -->
  <Match>
    <Class name="~com\.scalar\.db\.saga\.(api|exception)\..*"/>
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
  </Match>
</FindBugsFilter>
